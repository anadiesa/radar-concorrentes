# Supabase (local: valores impressos por `npx supabase status`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Somente no servidor: usado para criar usuários e para tarefas agendadas. Nunca expor no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Provedores de IA (opcionais). Também podem ser configurados em Administração → Configurações;
# se definidos aqui, têm prioridade sobre a tela.
OPENROUTER_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
GEMINI_API_KEY=

# URL pública do app (links de compartilhamento)
NEXT_PUBLIC_APP_URL=http://localhost:3000
