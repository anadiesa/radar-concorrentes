# Supabase (local: valores impressos por `npx supabase status`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Somente no servidor: usado para criar usuários e para tarefas agendadas. Nunca expor no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# OpenRouter (pesquisa de concorrentes). Opcional: também pode ser configurada na tela
# Administração → Configurações. Se definida aqui, tem prioridade sobre a tela.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# URL pública do app (links de compartilhamento)
NEXT_PUBLIC_APP_URL=http://localhost:3000
